## Данный файл содержит настройки, через которые можно кастомизировать вашу
## игру.
##
## Строки, начинающиеся  с двух '#' — комментарии, и вы не должны их
## раскомментировать. Строки, начинающиеся с одной '#' — комментированный код,
## который вы можете раскомментировать, если посчитаете это нужным.


## Основное ####################################################################

## Человекочитаемое название игры. Используется при установке стандартного
## заголовка окна, показывается в интерфейсе и отчётах об ошибках.
##
## Функция _(), окружающая строку, отмечает её как необходимую для перевода.

define config.name = _("ВЫМОРОЗОК")


## Показывать ли вышеуказанное название игры на экране главного меню. Установите
## на False, чтобы спрятать название.

define gui.show_name = True


## Версия игры.

define config.version = "1.0"


## Текст в экране "Об игре". Поместите текст между тройными кавычками. Для
## отделения абзацев оставляйте между ними пустую строку.

define gui.about = _p("""
    Ноябрь 1998 года. Глухой северный лес, колючая проволока и закрытый санаторий «Сосновый бор». Место, где под видом тишины и покоя у людей забирают самое ценное — воспоминания, страх и собственное имя.

    Это психологический триллер о попытке сохранить ясный рассудок там, где стены давят сильнее замков, а за привычной больничной рутиной скрывается древний лесной культ. Каждое твоё решение меняет восприятие реальности и приближает к одной из развязок.

    {i}Рекомендуется играть в наушниках в тишине.{/i}

    {color=#8fa3b0}Автор идеи, сценарий и разработка: by temka
    Telegram: @by_temka{/color}
    """)



## Короткое название игры, используемое для исполняемых файлов и директорий
## в сборочных пакетах. Оно должно содержать текст формата ASCII и не должно
## содержать пробелы, двоеточия и точки с запятой.

define build.name = "Vymorozok"


## Звуки и музыка ##############################################################

## Эти три переменные управляют, среди прочего, тем, какие микшеры видны игроку
## по умолчанию. Установка одной из них в False скроет соответствующий микшер.

define config.has_sound = True
define config.has_music = True
define config.has_voice = False


## Чтобы разрешить игроку тестировать громкость каналов звука или голоса,
## раскомментируйте строку ниже, и укажите аудиофайл для прослушивания.

# define config.sample_sound = "sample-sound.ogg"
# define config.sample_voice = "sample-voice.ogg"


## Раскомментируйте следующую строчку, чтобы настроить аудиофайл, который будет
## проигрываться в главном меню. Этот файл продолжит проигрываться во время
## игры, если не будет остановлен, или не начнёт проигрываться другой аудиофайл.

define config.main_menu_music = "audio/ambient.mp3"


## Переходы ####################################################################
##
## Эти переменные задают переходы (transition), используемые в различных
## событиях. Для каждой переменной должен быть установлен переход или None,
## чтобы никакой переход не использовался.

## Вход и выход в игровое меню.

define config.enter_transition = dissolve
define config.exit_transition = dissolve


## Переход между экранами игрового меню.

define config.intra_transition = dissolve


## Переход, используемый после загрузки слота сохранения.

define config.after_load_transition = None


## Используется при входе в главное меню после того, как игра закончится.

define config.end_game_transition = None


## Переменная, устанавливающая переход, когда старта игры не существует. Вместо
## неё используйте оператор with после показа начальной сцены.


## Управление окнами ###########################################################
##
## Эта строка контролирует когда будет видно диалоговое окно. Если "show" — оно
## всегда показано. Если "hide" — оно показывается, только когда представлен
## диалог. Если "auto" — окно будет скрываться оператором scene и снова
## показываться при появлении диалога.
##
## После начала игры этот параметр можно изменить с помощью операторов "window
## show", "window hide" и "window auto".

define config.window = "auto"


## Переходы, используемые при показе и скрытии диалогового окна

define config.window_show_transition = Dissolve(.2)
define config.window_hide_transition = Dissolve(.2)


## Стандартные настройки #######################################################

## Контролирует стандартную скорость текста. По умолчанию, это 0 — мгновенно,
## в то время как любая другая цифра — это количество символов, печатаемых в
## секунду.

default preferences.text_cps = 0


## Стандартная задержка авточтения. Большее значение означает более долгое
## ожидание, допустимый диапазон от 0 до 30.

default preferences.afm_time = 15


## Директория сохранений #######################################################
##
## Контролирует зависимое от платформы место, куда Ren'Py будет складывать файлы
## сохранения этой игры. Файлы сохранений будут храниться в:
##
## Windows: %APPDATA\RenPy\<config.save_directory>
##
## Macintosh: $HOME/Library/RenPy/<config.save_directory>
##
## Linux: $HOME/.renpy/<config.save_directory>
##
## Обычно этот параметр не нужно изменять, а если он изменён, то он должен быть
## текстовой строкой, а не выражением.

define config.save_directory = "Vymorozok-1794827129"


## Иконка ######################################################################
##
## Иконка, показываемая на панели задач или на доке.
define config.window_icon = "images/icon_app.jpg"

## Конфигурация сборки #########################################################
##
## Эта секция контролирует как Ren'Py будет собирать ваш проект в сборочные
## пакеты.

init python:

    ## Следующие функции принимают шаблоны файлов. Шаблоны
    ## нерегистрочувствительны, поиск выполняется из базовой директории, как с
    ## ведущим / так и без него. Если подходит несколько шаблонов, используется
    ## первый из них.
    ##
    ## В шаблоне:
    ##
    ## / это разделитель директорий.
    ##
    ## * включает в себя все символы, исключая разделитель директорий.
    ##
    ## ** включает в себя все символы, включая разделитель директорий.
    ##
    ## Например, "*.txt" берёт все файлы формата txt из базовой директории,
    ## "game/**.ogg" берёт все файлы ogg из директории game и всех её
    ## поддиректорий, а "**.psd" берёт все файлы psd из любого места в проекте.

    ## Классифицируйте файлы как None, чтобы исключить их из сборочных пакетов.

    build.classify('**~', None)
    build.classify('**.bak', None)
    build.classify('**/.**', None)
    build.classify('**/#**', None)
    build.classify('**/thumbs.db', None)

    ## Чтобы архивировать файлы, классифицируйте их как 'archive'.

    # build.classify('game/**.png', 'archive')
    # build.classify('game/**.jpg', 'archive')

    ## Файлы, соответствующие шаблонам документации, дублируются в сборках для
    ## Mac, так что они появятся и в приложении и в zip-архиве.

    build.documentation('*.html')
    build.documentation('*.txt')


