init python:
    import os

    def create_secret_note():
        try:
            note_path = os.path.join(config.basedir, "не_пей_сбор.txt")
            if not os.path.exists(note_path):
                with open(note_path, "w", encoding="utf-8") as f:
                    f.write("Палата №3. Второй этаж.\n")
                    f.write("Если ты это читаешь — не глотай то, что дает Тамара на посту.\n")
                    f.write("После трех ночей ты перестаешь помнить имя матери. На пятую ночь ты просто сидишь и смотришь в стену.\n")
                    f.write("Дверь в закрытое крыло открывается только после полуночи.\n")
        except Exception:
            pass

define narrator = Character(None, what_color="#cccccc")
define gg = Character("Глеб", color="#8fa3b0")
define driver = Character("Водитель", color="#7a7a7a")
define guard = Character("Охранник Вадим", color="#6d7873")
define nurse = Character("Тамара Павловна", color="#9e8c8c")
define alisa = Character("Алиса", color="#a69b9b")
define doctor = Character("Аркадий Семёнович", color="#a3b5bd")

default sanity = 100
default drank_medicine = False
default argued_phone = False
default found_note = False

screen sanity_hud():
    frame:
        xpos 35
        ypos 30
        padding (18, 12)
        background Frame(Solid("#0b0c0dcc"), Borders(1, 1, 1, 1))
        vbox:
            spacing 6
            text "ЯСНОСТЬ: [sanity]%" size 20 color "#8fa3b0" font "georgia.ttf"
            bar value sanity range 100 xsize 210 ysize 6 left_bar Solid("#8fa3b0") right_bar Solid("#26292b")
transform breathing_cam:
    xalign 0.5
    yalign 0.5
    xsize 1960
    ysize 1102
    parallel:
        ease 6.0 zoom 1.03
        ease 6.0 zoom 1.0
        repeat
    parallel:
        ease 4.5 xoffset -6 yoffset -4
        ease 4.5 xoffset 6 yoffset 4
        repeat

transform tense_cam:
    xalign 0.5
    yalign 0.5
    xsize 1980
    ysize 1114
    parallel:
        ease 3.0 zoom 1.05
        ease 3.0 zoom 1.01
        repeat
    parallel:
        ease 2.5 xoffset -8 yoffset -5
        ease 2.5 xoffset 8 yoffset 5
        repeat

label splashscreen:
    scene black
    with Pause(0.5)
    show logo at truecenter:
        zoom 0.55
    with Dissolve(1.5)
    with Pause(2.0)
    hide logo
    with Dissolve(1.5)
    with Pause(0.5)
    return
label start:
    show screen sanity_hud

    stop music fadeout 2.0
    play sound "audio/rain.mp3" loop fadein 2.0

    scene bg_road at breathing_cam
    with fade

    "Ноябрь. Северная трасса тянулась сквозь глухой ельник, словно серый шрам, затянутый ледяным туманом."
    "Дождь не прекращался третий день подряд. За мокрым стеклом старого автобуса черные стволы деревьев сливались в сплошную стену."

    driver "Конечная, парень. Дальше дороги нет — только лесовозная колея и болота."
    gg "И это... и есть санаторий? Тут же вокруг ни одной живой души."
    driver "«Сосновый бор». Для таких, как ты, самое то. Выгружайся, мне еще до темноты обратно на трассу выбраться надо."

    scene bg_gates at breathing_cam
    with dissolve

    "Тяжелая дверь автобуса со скрипом захлопнулась, и красные габариты растворились в тумане."
    "Я остался один перед ржавыми воротами. Над ними тускло горела одинокая лампа, выхватывая из темноты табличку: «Корпус № 1»."

    menu:
        "Что сделать в первую очередь?"

        "Подойти к воротам и нажать на кнопку звонка":
            gg "Ладно. Обратного пути все равно нет."
            "Кнопка оказалась холодной и мокрой. Внутри сторожки за стеклом мелькнула чья-то тень."

        "Осмотреться вдоль забора, ища обход или следы":
            $ sanity -= 5
            gg "Странное место. Забор больше похож на тюремный, чем на больничный."
            "Вдоль бетонных плит тянулась колючая проволока, а прямо за ней начинался темный, непроглядный лес."

    play audio "audio/gate.mp3"
    "Тяжелый засов лязгнул, и ворота медленно поползли в сторону."

    play audio "<from 0.0 to 3.5>audio/footsteps.mp3"
    scene bg_vadim at tense_cam
    with dissolve

    "Из полумрака сторожки вышел крупный мужчина в промокшем бушлате. Он оглядел меня с ног до головы, задержав тяжелый взгляд на спортивной сумке."

    guard "Новенький? Фамилия."
    gg "Морозов. Глеб Морозов. Меня по направлению из города прислали."
    guard "Вадим. Заходи и ворота за собой не задерживай — сырость напускаешь."
    guard "По территории один не шляйся. После отбоя выход из корпуса запрещен. Увижу у забора — церемониться не буду."
    play audio "<from 0.0 to 4.0>audio/footsteps.mp3"
    scene bg_yard at breathing_cam
    with dissolve

    "Он развернулся и тяжело зашагал по мокрому асфальту к мрачному четырехэтажному зданию в глубине двора."
    "Над черными окнами едва светилось лишь одно окно на втором этаже. Мне ничего не оставалось, кроме как поплестись следом."

    stop sound fadeout 1.5
    play music "audio/ambient.mp3" loop fadein 2.0
    play audio "audio/door_creak.mp3"

    scene bg_corridor at breathing_cam
    with fade

    "Тяжелая входная дверь закрылась за спиной с гулким стуком, отрезая шум дождя."
    "Внутри пахло старой хлоркой, сырой штукатуркой и резкими, горькими лекарствами."
    "Охранник толкнул дверь с облупившейся табличкой «Приемный покой» и кивнул внутрь."

    guard "Дальше сама разберется. Жди здесь."

    scene bg_reception at breathing_cam
    with dissolve

    "За обшарпанным столом под холодным светом лампы сидела женщина лет пятидесяти в сером халате. Она даже не подняла головы от журнала."

    nurse "Документы и направление на стол. Сумку — на кушетку, расстегнуть."
    gg "Здравствуйте. Я Морозов..."
    nurse "Я умею читать, молодой человек. Меня зовут Тамара Павловна, я здесь старшая медсестра."
    nurse "Телефон, зарядку, часы и любые колющие предметы выкладываем в этот лоток. Связь здесь все равно не ловит."

    menu:
        "Как отреагировать на требование сдать телефон?"

        "Молча выложить телефон на стол":
            gg "Держите. Там все равно батарея почти села."
            nurse "Вот и славно. Люблю тех, кто не создает проблем с порога."

        "Попытаться возразить и оставить телефон при себе":
            $ argued_phone = True
            gg "Постойте, мне обещали, что я смогу звонить домой хотя бы вечером."
            "Тамара Павловна медленно подняла на меня ледяной взгляд. В комнате сразу стало тихо."
            nurse "Здесь лечат голову и нервы, Морозов, а не сидят в чатах. Позвонишь раз в неделю с поста. Клади на стол."
            "Спорить было бесполезно. Я достал телефон и положил в металлический лоток."

    scene bg_glass at tense_cam
    with dissolve

    "Она убрала телефон в ящик стола и щелкнула ключом. Затем достала из шкафа аптечный пузырек и налила в граненый стакан мутную темную жидкость."

    nurse "Сейчас выпьешь это — снимет дорожное напряжение. Потом пойдешь на второй этаж, третья палата слева."
    gg "А что это за лекарство? Мне врач в городе ничего такого не назначал."
    nurse "Обычный седативный сбор, здесь все его принимают в первый вечер. И запомни главное правило, Глеб..."
    nurse "Если ночью услышишь шаги в коридоре или стук в окно — не вставай и не открывай дверь. Это просто сквозняк."

    play audio "audio/heartbeat.mp3"
    menu:
        "Что сделать со стаканом?"

        "Выпить горькую жидкость, чтобы не вызывать подозрений":
            $ drank_medicine = True
            $ sanity -= 15
            with vpunch
            scene bg_reception at breathing_cam
            with dissolve
            "Жидкость оказалась ледяной и отдавала полынью. Через пару секунд в висках глухо зашумело, а края зрения поплыли."
            nurse "Молодец. А теперь иди отдыхать, завтра в семь подъем на процедуры."

        "Сделать вид, что пьешь, и незаметно вылить в рукав":
            $ drank_medicine = False
            scene bg_reception at breathing_cam
            with dissolve
            "Пока медсестра отвернулась к журналу, я быстро опрокинул содержимое стакана в манжету куртки и вытер губы."
            nurse "Вот и хорошо. Иди на второй этаж, третья дверь слева. И не вздумай бродить по коридорам."

    play audio "audio/door_creak.mp3"
    scene bg_corridor at breathing_cam
    with dissolve

    "Я подхватил сумку и вышел в тусклый пустой коридор. Где-то наверху протяжно скрипнула дверь."
    scene black
    with fade

    centered "{color=#8fa3b0}{size=26}ДЕНЬ 1. 22:45\nКОРПУС № 1 — ЛЕСТНИЧНЫЙ ПРОЛЕТ ВТОРОГО ЭТАЖА{/size}{/color}"
    with Pause(1.5)

    scene bg_stairs at tense_cam
    with fade

    "Бетонные ступени были влажными от сырости. На площадке между этажами тускло мигала лампочка под ржавой решеткой."
    "Я уже взялся за перила, когда заметил в полумраке худую девушку в темном свитере. Она стояла в полуобороте, вцепившись пальцами в металл."

    gg "Эй... Ты тоже здесь живешь? Где тут третья палата?"
    "Она медленно повернула голову. Половина ее лица тонула в глубокой тени, но я заметил темные круги под глазами и затравленный взгляд."
    alisa "Новенький... Тебя уже напоили на посту?"

    if drank_medicine:
        gg "Дали какой-то горький отвар. Сказали, успокоительное с дороги."
        "Девушка судорожно сглотнула и отступила на шаг в тень, глядя на меня так, словно я уже обречен."
        alisa "Зря. Теперь ночью не сможешь проснуться, даже если захочешь. Только не спорь с ними утром, слышишь? Не смотри в глаза..."
    else:
        gg "Пытались, но я вылил эту дрянь в рукав. Что вообще здесь творится?"
        "В ее глазах на секунду мелькнуло удивление, но тут же сменилось животным страхом."
        alisa "Тише! У Вадима слух как у собаки... После полуночи не спи. И ни за что не ходи в левое крыло, если не хочешь остаться здесь без имени."

    play audio "<from 0.0 to 3.0>audio/footsteps.mp3"
    "Внизу на первом этаже глухо хлопнула дверь и заскрипели тяжелые ботинки."

    alisa "Идет... Меня здесь не было. Третья дверь слева, запрись изнутри."
    "Она бесшумно скользнула вверх по ступеням и растворилась в темноте."

    play audio "audio/door_creak.mp3"
    scene bg_room at breathing_cam
    with fade

    "Третья палата встретила ледяным сквозняком. Две железные койки с серыми одеялами, ржавая батарея и обшарпанная тумбочка."
    "За мутным стеклом в темноте раскачивались черные верхушки елей, по которым хлестал дождь."
    "Я бросил сумку на кровать у стены. Взгляд зацепился за приоткрытый ящик деревянной тумбочки."

    menu:
        "Что сделать перед сном?"

        "Осмотреть ящик старой тумбочки":
            $ found_note = True
            $ create_secret_note()
            play audio "audio/paper.mp3"
            scene bg_note at tense_cam
            with dissolve
            "Внутри лежал вырванный из больничной карты помятый лист. К низу страницы ровные строчки превращались в нервные, рваные каракули."
            "«День четвертый. Голова как ватная. Забыл, как звали собаку. Забыл номер дома. Они говорят, так и должно быть...»"
            "В самом углу листа ногтем или тупым карандашом было процарапано одно слово: «НЕ ПЕЙ»."
            scene bg_room at breathing_cam
            with dissolve
            "Я сунул обрывок под матрас. По коже поползли мурашки."

        "Не трогать чужие вещи и сразу лечь под одеяло":
            $ found_note = False
            "Я решил не лезть в чужие тайники в первый же вечер. Забравшись под колючее одеяло, я натянул куртку сверху."
    scene black
    with fade

    centered "{color=#8fa3b0}{size=26}НОЧЬ. 01:15\nТИШИНА В КОРПУСЕ{/size}{/color}"
    with Pause(1.5)

    play audio "<from 0.0 to 4.5>audio/footsteps.mp3"
    play audio "audio/heartbeat.mp3"
    "Снаружи завывал ветер. Сквозь шум дождя за дверью палаты послышались медленные, шаркающие шаги и тихий металлический звон."

    if drank_medicine:
        $ sanity -= 10
        with vpunch
        "Я попытался приподняться, но тело словно налили свинцом. Отвар Тамары Павловны сковал мышцы, а перед глазами поплыли серые пятна."
        "Дверная ручка снаружи медленно повернулась вниз, затем вернулась на место. Кто-то постоял за тонкой фанерой, тяжело дыша, и пошел дальше."
        "Проваливаясь в мутный сон без сновидений, я понял, что выбраться отсюда будет намного сложнее, чем казалось."
    else:
        "Голова оставалась абсолютно ясной. Стараясь не скрипнуть пружинами, я встал на холодный пол и подкрался к двери."
        play audio "audio/door_creak.mp3"
        scene bg_peephole at tense_cam
        with dissolve
        "Через узкую щель было видно, как в конце коридора движется фигура в белом халате с фонариком, а следом двое санитаров ведут под руки подростка."
        "Голова парня безвольно болталась на груди. Они скрылись за тяжелой металлической дверью закрытого крыла."

    scene bg_room at breathing_cam
    with fade

    "Остаток ночи прошел в гнетущей, ледяной тишине. До утра оставалось меньше четырех часов."

    # --- СЦЕНА 4: УТРО, СТОЛОВАЯ И ГЛАВВРАЧ ---
    stop music fadeout 2.0
    play music "audio/day_ambient.mp3" loop fadein 2.0

    scene black
    with fade

    centered "{color=#8fa3b0}{size=26}ДЕНЬ 2. 07:10\nУТРЕННИЙ ОБХОД И СТОЛОВАЯ{/size}{/color}"
    with Pause(1.5)

    play audio "audio/door_creak.mp3"
    scene bg_canteen at breathing_cam
    with fade

    "Холодный серый свет едва пробивался сквозь высокие запыленные окна столовой. В воздухе стоял запах переваренной каши и дешевого хлора."
    "За длинными металлическими столами сидели около десяти подростков в одинаковых серых кофтах. Никто не разговаривал и не гремел ложками."
    "Они двигались медленно, механически, глядя пустыми стеклянными глазами куда-то мимо тарелок. Настоящие выморозки."

    if drank_medicine:
        $ sanity -= 5
        "Голова гудела, как пустое ведро. Я сел на край скамьи и поймал себя на том, что несколько секунд просто тупо смотрю в серую стену, забыв взять ложку."
    else:
        "Я сел с краю, стараясь не выделяться, и быстро оглядел зал. Алисы среди них не было — и пустых мест за столами оказалось на два больше, чем вчера в журнале."

    play audio "<from 0.0 to 3.5>audio/footsteps.mp3"
    "Тяжелые шаги в коридоре заставили меня опустить взгляд в тарелку. В дверях столовой показалась Тамара Павловна."

    nurse "Морозов. Доедай и на выход. Главврач ждет тебя в кабинете на первом этаже. Живее."
    play audio "audio/door_creak.mp3"
    scene bg_doctor_office at breathing_cam
    with fade

    "В кабинете было стерильно и холодно. За массивным столом под тусклой лампой сидел худощавый старик в белом халате и круглых очках с толстыми стеклами."
    "Он изучал мою карту, не моргая. Стеклянные склянки в шкафу за его спиной тускло поблескивали в полумраке."

    doctor "Присаживайся, Глеб. Я Аркадий Семёнович, руководитель этого учреждения. Как прошла первая ночь?"

    menu:
        "Как ответить главврачу?"

        "Ответить спокойно и покорно, не вызывая подозрений":
            gg "Нормально, доктор. Спал крепко, сразу вырубился с дороги."
            doctor "Прекрасно. Сбор Тамары Павловны отлично снимает тревожность. Значит, адаптация идет по плану."

        "Сказать правду, что в корпусе слишком холодно и странно":
            $ sanity -= 5
            gg "Здесь ледяные стены и двери запирают снаружи. Это больше похоже на изолятор, чем на санаторий."
            "Аркадий Семёнович снял очки и медленно протер стекла платком. В кабинете повисла тяжелая тишина."
            doctor "Острый ум и недоверие — типичные симптомы твоего состояния, Глеб. Но здесь мы быстро убираем этот лишний шум в голове."

    scene bg_test at tense_cam
    with dissolve

    "Врач пододвинул ко мне черно-белую карточку с расплывчатым чернильным пятном. Рядом на металлическом лотке лежал стеклянный шприц."

    doctor "Посмотри на рисунок и скажи первое, что приходит в голову. Не думай, просто назови образ."

    play audio "audio/heartbeat.mp3"
    menu:
        "Что ответить на тест?"

        "«Обычное чернильное пятно, ничего особенного»":
            gg "Просто клякса на бумаге. Симметричная, как у всех таких тестов."
            doctor "Хм. Рационализация. Защитная реакция психики."

        "«Похоже на темный лес или чью-то тень между деревьями»":
            $ sanity -= 5
            gg "Как будто кто-то стоит в чаще и смотрит из темноты."
            "В уголках губ старика мелькнула едва заметная, холодная усмешка. Он сделал пометку в карте."
            doctor "Очень интересно. Восприимчивое сознание. Лес здесь действительно близко, Глеб... ближе, чем кажется."

    scene bg_doctor_office at breathing_cam
    with dissolve

    doctor "На сегодня свободен. До обеда — тихий час в палате. И не вздумай заходить в левое крыло — там идет санитарная обработка."
    "Я вышел из кабинета с четким ощущением, что за каждым моим шагом здесь следят не ради лечения."

    # --- СЦЕНА 5: ТИХИЙ ЧАС, БИБЛИОТЕКА И ЗНАК КУЛЬТА ---
    scene black
    with fade

    centered "{color=#8fa3b0}{size=26}ДЕНЬ 2. 14:20\nТИХИЙ ЧАС — СТАРАЯ БИБЛИОТЕКА{/size}{/color}"
    with Pause(1.5)

    play audio "audio/door_creak.mp3"
    scene bg_library at breathing_cam
    with fade

